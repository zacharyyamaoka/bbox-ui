# assets/bbox-ui.desktop — the dock icon Zach presses.
#
# Zach, 2026-09-21: "please connect the bbox whiteboard app to open when I
# press bbox-ui". It used to open the DOCS SITE (scripts/launch_bboxui.py);
# it now opens the whiteboard, and the site it used to open is one ☰ row
# inside that app (apps/systemsketch/src/chrome/sites.ts) plus the right-click
# actions below.
#
# WHY StartupWMClass is `bbox-ui` — and why it USED to say `systemsketch`.
#
# It must match the WM_CLASS the window actually carries, which
# scripts/launch_systemsketch.py gives Chrome as `--class=$APP_ID`. That class
# was `systemsketch`, shared with the archived app on purpose so the in-app
# "Switch to old SystemSketch" row kept both under one dock icon.
#
# Measured 2026-09-22, and the sharing turned out to cost exactly what it was
# meant to buy: the window did NOT group under this entry. systemsketch.desktop
# claimed the same class, and GNOME breaks that tie for the entry whose ID
# equals the class (gnome-shell 46.0 src/shell-app-system.c:142-144). So
# pressing bbox-ui lit the SystemSketch slot, showed `Icon=systemsketch`, and
# four icon redesigns were applied to an icon the dock never displayed.
#
# Zach, 2026-09-24: "When I press the bbox-ui icon it opens system sketch which
# is not desired!" — so the tie is gone. This app owns `bbox-ui`; the archived
# app keeps `systemsketch` and systemsketch.desktop launches ONLY the archived
# app now. The Chrome profile is still shared between the two, which is what
# the switch row actually needs; the window class never was.
[Desktop Entry]
Type=Application
Name=bbox-ui
GenericName=Black box whiteboard
Comment=Blocks, ports and edges on a board — ☰ also opens bbox-ui.com and Storybook
Exec=/usr/bin/python3 /home/bam/bbox-ui/scripts/launch_systemsketch.py --open
TryExec=/usr/bin/python3
Icon=bbox-ui
Terminal=false
Categories=Development;Graphics;
Keywords=bbox-ui;Whiteboard;Design;Components;Registry;Blocks;Ports;Edges;
StartupWMClass=bbox-ui
StartupNotify=true
Actions=OpenSite;OpenSitePreview;UpdateFromMain;

[Desktop Action OpenSite]
Name=Open bbox-ui.com (deployed)
Exec=/usr/bin/python3 /home/bam/bbox-ui/scripts/launch_bboxui.py --remote --open

[Desktop Action OpenSitePreview]
Name=Open the site's local Preview (HMR)
Exec=/usr/bin/python3 /home/bam/bbox-ui/scripts/launch_bboxui.py --preview --open

[Desktop Action UpdateFromMain]
Name=Update the whiteboard to latest main
Exec=/usr/bin/python3 /home/bam/bbox-ui/scripts/launch_systemsketch.py --update --open
