{
  "name": "demo-dndkit-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype: dnd-kit sortable/droppable interactions for moving a port between containers. Plain DOM — no React Flow or tldraw.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build",
    "dev": "vite --port 5195 --strictPort",
    "preview": "vite preview --port 5195 --strictPort"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
