{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "bbox-ui",
  "homepage": "https://github.com/zachyamaoka/bbox-ui",
  "items": [
    {
      "name": "bbox-layout",
      "type": "registry:lib",
      "title": "bbox layout",
      "description": "Portable layout geometry for black-box design components. Pure module — no React, no canvas engine.",
      "files": [
        {
          "path": "packages/bbox-ui/src/layout.ts",
          "type": "registry:lib",
          "target": "lib/bbox/layout.ts"
        }
      ]
    },
    {
      "name": "port",
      "type": "registry:component",
      "title": "Port",
      "description": "A circle with a text slot. Four states (Empty / Default Value / Wired / Data Recived), six text layouts, three diameters, three text rungs.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "packages/bbox-ui/src/port.tsx",
          "type": "registry:component",
          "target": "components/bbox/port.tsx"
        },
        {
          "path": "packages/bbox-ui/src/layout.ts",
          "type": "registry:lib",
          "target": "lib/bbox/layout.ts"
        }
      ]
    },
    {
      "name": "block",
      "type": "registry:component",
      "title": "Block (Simple View)",
      "description": "The black-box Block in Simple View: Container, Header band, Glyph, Text slots, Chip. Icon rides the title rung at 0.9×.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "packages/bbox-ui/src/block.tsx",
          "type": "registry:component",
          "target": "components/bbox/block.tsx"
        },
        {
          "path": "packages/bbox-ui/src/layout.ts",
          "type": "registry:lib",
          "target": "lib/bbox/layout.ts"
        }
      ]
    },
    {
      "name": "block-node-reactflow",
      "type": "registry:component",
      "title": "Block node (React Flow adapter)",
      "description": "React Flow custom node wrapping the Block; ports emit <Handle> DOM elements painted with the shared port-dot classes.",
      "dependencies": ["@xyflow/react"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "packages/adapter-reactflow/src/block-node.tsx",
          "type": "registry:component",
          "target": "components/bbox/block-node.tsx"
        }
      ]
    },
    {
      "name": "block-shape-tldraw",
      "type": "registry:component",
      "title": "Block ShapeUtil (tldraw adapter)",
      "description": "tldraw ShapeUtil rendering the Block inside HTMLContainer; shape w/h are authoritative and port anchors are geometry points.",
      "dependencies": ["tldraw@5.3.2"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "packages/adapter-tldraw/src/block-shape-util.tsx",
          "type": "registry:component",
          "target": "components/bbox/block-shape-util.tsx"
        }
      ]
    },
    {
      "name": "code-field",
      "type": "registry:component",
      "title": "Code Field",
      "description": "A code text box — one line or a multi-line lane of real CodeMirror 6, grammar-agnostic. Plug in a `grammar` (slots, marks, completions, an optional rendered tree) or use it as a plain code line. Zero canvas assumptions.",
      "dependencies": [
        "@codemirror/autocomplete",
        "@codemirror/commands",
        "@codemirror/language",
        "@codemirror/state",
        "@codemirror/view",
        "@lezer/highlight"
      ],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "packages/bbox-ui/src/codeField.tsx",
          "type": "registry:component",
          "target": "components/bbox/codeField.tsx"
        },
        {
          "path": "packages/bbox-ui/src/codeFieldRows.tsx",
          "type": "registry:component",
          "target": "components/bbox/codeFieldRows.tsx"
        },
        {
          "path": "packages/bbox-ui/src/codeGrammar.ts",
          "type": "registry:lib",
          "target": "lib/bbox/codeGrammar.ts"
        },
        {
          "path": "packages/bbox-ui/src/fieldGesture.ts",
          "type": "registry:lib",
          "target": "lib/bbox/fieldGesture.ts"
        },
        {
          "path": "packages/bbox-ui/src/caretGeometry.ts",
          "type": "registry:lib",
          "target": "lib/bbox/caretGeometry.ts"
        },
        {
          "path": "packages/bbox-ui/src/codeField.css",
          "type": "registry:file",
          "target": "components/bbox/codeField.css"
        },
        {
          "path": "packages/bbox-ui/src/codeTokens.css",
          "type": "registry:file",
          "target": "components/bbox/codeTokens.css"
        }
      ]
    },
    {
      "name": "code-field-signature",
      "type": "registry:component",
      "title": "Code Field — signature grammar",
      "description": "`CodeField`'s first grammar: `name: Type = default`, the way Python already spells a parameter. One line is a port row, several lines are a lane — pass `types`/`values` for completions, `resolveReference` for a clickable/expandable rendered tree.",
      "dependencies": ["@codemirror/lang-python"],
      "registryDependencies": ["utils", "code-field"],
      "files": [
        {
          "path": "packages/bbox-ui/src/signature.ts",
          "type": "registry:lib",
          "target": "lib/bbox/signature.ts"
        },
        {
          "path": "packages/bbox-ui/src/signatureGrammar.ts",
          "type": "registry:lib",
          "target": "lib/bbox/signatureGrammar.ts"
        }
      ]
    }
  ]
}
