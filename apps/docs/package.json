{
  "name": "@bbox-ui/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts-copy-registry.mjs && node --experimental-strip-types ./src/scripts/build-registry.mts && next build",
    "dev": "next dev --port=4100",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "registry:build": "node --experimental-strip-types ./src/scripts/build-registry.mts",
    "registry:copy": "node scripts-copy-registry.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@bbox-ui/core": "workspace:*",
    "@bbox-ui/panel": "workspace:*",
    "@bbox-ui/schema": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fumadocs/satteri": "0.x.x",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@orama/orama": "^3.1.18",
    "@takumi-rs/image-response": "^2.9.2",
    "@xyflow/react": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.4",
    "jotai": "^2.20.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-arborist": "3.16.0",
    "react-aria-components": "1.21.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "3.0.6",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.4",
    "satteri": "^0.9.4",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tldraw": "5.3.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tldraw/tlschema": "5.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
