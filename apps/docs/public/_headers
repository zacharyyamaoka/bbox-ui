# Cloudflare Pages headers. WHY this file exists at all: GitHub Pages cannot do
# this, and it is one of the two reasons the site is here instead.

# Next fingerprints these, so they can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The registry is what `npx shadcn add https://bbox-ui.com/r/<name>.json` reads.
# Served as JSON, and kept short-lived so a published component fix reaches
# people the same day rather than sitting in a CDN cache.
/r/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
