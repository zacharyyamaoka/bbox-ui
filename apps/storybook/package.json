{
  "name": "bbox-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "T0 SPIKE: can one Storybook story render in three hosts (plain DOM, a real React Flow node, a real tldraw shape) switched by a toolbar dropdown? See report at reports/ for the full write-up.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "storybook": "storybook dev -p 5420 --ci",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@bbox-ui/core": "workspace:*",
    "@bbox-ui/schema": "workspace:*",
    "@bbox-ui/story-hosts": "workspace:*",
    "@xyflow/react": "^12.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "5.3.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
