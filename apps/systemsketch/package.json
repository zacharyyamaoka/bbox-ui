{
  "name": "systemsketch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SystemSketch, rebuilt as bbox-ui + stock tldraw: the trunk (apps/storybook-basics/src) reached through one @trunk alias, no vendored copy.",
  "scripts": {
    "dev": "vite --port 4340 --strictPort",
    "preview": "vite preview --port 4340 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test-unit": "vitest --project=unit run",
    "test-smoke": "vitest --project=smoke run"
  },
  "dependencies": {
    "@tldraw/assets": "5.3.2",
    "bbox-storybook-basics": "workspace:*",
    "elkjs": "0.12.0",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "5.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tldraw/tlschema": "5.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
