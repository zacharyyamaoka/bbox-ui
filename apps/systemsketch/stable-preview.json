{
  "app": "bbox-ui",
  "name": "bbox studio",
  "stable": {
    "port": 4341,
    "processes": [
      {
        "name": "files",
        "port": 4342,
        "command": ["python3", "{source}/../../scripts/systemsketch_files.py", "serve", "--files-root", "{home}", "--host", "127.0.0.1", "--port", "{port}", "--recordings"],
        "health": "/api/health"
      }
    ],
    "proxy": { "/api/workspace": "files", "/api/recordings": "files" }
  },
  "preview": { "port": 4340 },
  "chip": { "position": "bottom-right", "avoid": ["[data-slot=\"status-strip\"]"] },
  "snapshot": { "exclude": ["review/", "README.md", "**/*.test.ts", "**/*.test.tsx"] }
}
