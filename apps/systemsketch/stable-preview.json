{
  "app": "bbox-ui",
  "name": "bbox studio",
  "stable": {
    "port": 4341,
    "processes": [
      {
        "name": "files",
        "port": 4342,
        "command": ["python3", "{source}/../../scripts/systemsketch_files.py", "serve", "--files-root", "{home}", "--source-root", "{root}/../..", "--host", "127.0.0.1", "--port", "{port}", "--recordings"],
        "health": "/api/health"
      }
    ],
    "proxy": { "/api/workspace": "files", "/api/recordings": "files" }
  },
  "preview": { "port": 4340 },
  "chip": { "position": "bottom-right", "avoid": ["[data-slot=\"status-strip\"]"] },
  "snapshot": {
    "exclude": ["review/", "README.md", "**/*.test.ts", "**/*.test.tsx"],
    "link": ["node_modules", "../storybook-basics/node_modules"],
    "include": [
      "../storybook-basics/src",
      "../storybook-basics/package.json",
      "../storybook-basics/tsconfig.json",
      "../../packages/glyph-content",
      "../../tsconfig.base.json",
      "../../package.json",
      "../../pnpm-lock.yaml",
      "../../scripts/systemsketch_files.py",
      "../../scripts/systemsketch_recordings.py"
    ]
  }
}
