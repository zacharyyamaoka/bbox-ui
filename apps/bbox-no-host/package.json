{
  "name": "bbox-no-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The shell with no whiteboard behind it: every window mounted on an in-memory fake host. The runner half of the diagram's app/bbox-no-host box.",
  "scripts": {
    "dev": "vite --port 4360 --strictPort",
    "preview": "vite preview --port 4360 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "bbox-storybook-basics": "workspace:*",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
