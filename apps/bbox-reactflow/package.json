{
  "name": "bbox-reactflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The React Flow host behind the same shell as the tldraw studio: simple-reactflow-whiteboard (MIT) as the canvas, the trunk (apps/storybook-basics/src) through one @trunk alias. The one shippable host, since tldraw needs a licence on a public page. Skeleton from B-DEPS; L-RF-HOST fills src/.",
  "scripts": {
    "dev": "vite --port 4370 --strictPort",
    "preview": "vite preview --port 4370 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test-unit": "vitest --project=unit run",
    "test-smoke": "vitest --project=smoke run"
  },
  "bboxUi": {
    "whiteboardPin": {
      "repo": "/home/bam/simple-reactflow-whiteboard",
      "branch": "claude/open-as-library-2026-09-19",
      "commit": "12667720aa0db8213082eda4d6b41f8461c33e47",
      "worktree": "/home/bam/simple-reactflow-whiteboard-lib"
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "bbox-storybook-basics": "workspace:*",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "simple-reactflow-whiteboard": "file:./simple-reactflow-whiteboard"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
