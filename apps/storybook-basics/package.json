{
  "name": "bbox-storybook-basics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reset lane: component-based design from the simplest primitives up, one Storybook story at a time. No dependency on packages/bbox-ui — components here are deliberately unstyled and start from zero.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "storybook": "storybook dev -p 5421 --ci",
    "build-storybook": "storybook build -o storybook-static",
    "test-stories": "vitest --project=storybook run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@bbox-ui/glyph-content": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.38.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
